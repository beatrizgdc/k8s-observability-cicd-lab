// Pipeline do DevOps Interview Lab. Roda dentro do container Jenkins (cicd/), que tem
// docker CLI, kubectl, kind, trivy e sonar-scanner instalados.
pipeline {
  agent any
  options {
    timestamps()
    timeout(time: 15, unit: 'MINUTES')
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '15'))
  }
  parameters {
    booleanParam(name: 'DEPLOY', defaultValue: true, description: 'Fazer deploy no cluster Kind ao final')
    choice(name: 'TRIVY_FAIL_ON', choices: ['CRITICAL', 'HIGH,CRITICAL', 'NONE'],
           description: 'Severidades que reprovam o Security Scan (NONE = só relatório)')
  }
  environment {
    IMAGE           = 'lab-app'
    TAG             = "jenkins-${env.BUILD_NUMBER}"
    TRIVY_CACHE_DIR = '/trivy-cache'
    SONAR_HOST      = 'http://lab-sonarqube:9000'
  }
  stages {
    stage('Checkout') {
      steps {
        checkout scm
        sh 'git log -1 --pretty="commit %h por %an: %s"'
      }
    }
    stage('Build') {
      steps {
        sh '''
          python3 -m venv .venv
          . .venv/bin/activate
          pip install -q --disable-pip-version-check -r requirements-dev.txt
          python -m py_compile app.py
          echo "dependências instaladas e código compila"
        '''
      }
    }
    stage('Test') {
      steps {
        sh '. .venv/bin/activate && pytest --junitxml=report.xml --cov=app --cov-report=xml --cov-report=term'
      }
      post { always { junit allowEmptyResults: true, testResults: 'report.xml' } }
    }
    stage('Code Quality') {
      steps {
        sh '. .venv/bin/activate && flake8 .'          // lint: falha o build se houver erro de estilo/sintaxe
        script {
          def tokenFile = '/lab/secrets/sonar-token'
          def up = sh(returnStatus: true, script: "curl -fsS ${SONAR_HOST}/api/system/status | grep -q UP") == 0
          if (fileExists(tokenFile) && up) {
            sh '''
              sonar-scanner -Dsonar.host.url=$SONAR_HOST -Dsonar.token=$(cat /lab/secrets/sonar-token) \
                            -Dsonar.qualitygate.wait=true -Dsonar.qualitygate.timeout=180
            '''
          } else {
            echo 'SonarQube indisponível (rode: ./lab.sh start security && ./lab.sh sonar-setup). Pulando análise Sonar; flake8 foi executado.'
          }
        }
      }
    }
    stage('Security Scan') {
      steps {
        script {
          def sev = params.TRIVY_FAIL_ON
          def code = (sev == 'NONE') ? 0 : 1
          def sevArg = (sev == 'NONE') ? 'HIGH,CRITICAL' : sev
          // SCA: dependências do requirements.txt + misconfigurações do Dockerfile
          sh "trivy fs --skip-db-update --scanners vuln,misconfig --severity ${sevArg} --ignore-unfixed --exit-code ${code} ."
        }
      }
    }
    stage('Docker Build') {
      steps {
        sh 'docker build -t ${IMAGE}:${TAG} --build-arg APP_VERSION=1.0.${BUILD_NUMBER} .'
        script {
          def sev = params.TRIVY_FAIL_ON
          def code = (sev == 'NONE') ? 0 : 1
          def sevArg = (sev == 'NONE') ? 'HIGH,CRITICAL' : sev
          // Container scan: SO base + pacotes da imagem final
          sh "trivy image --skip-db-update --severity ${sevArg} --ignore-unfixed --exit-code ${code} ${IMAGE}:${TAG}"
        }
      }
    }
    stage('Deploy Kubernetes') {
      when { expression { params.DEPLOY } }
      steps {
        sh '''
          kind load docker-image ${IMAGE}:${TAG} --name lab
          kubectl -n demo set image deployment/lab-app app=${IMAGE}:${TAG}
          kubectl -n demo set env deployment/lab-app APP_VERSION=1.0.${BUILD_NUMBER}
          kubectl -n demo rollout status deployment/lab-app --timeout=120s
          curl -fsS http://lab-control-plane:30080/info
        '''
      }
      post {
        failure {
          // rollback automático: volta para a revisão anterior se o rollout falhou
          sh 'kubectl -n demo rollout undo deployment/lab-app || true'
        }
      }
    }
  }
  post {
    success { echo "Pipeline OK: ${IMAGE}:${TAG}" }
    failure { echo 'Pipeline FALHOU: veja o estágio marcado em vermelho e o Console Output' }
    always  { sh 'rm -rf .venv' }
  }
}
